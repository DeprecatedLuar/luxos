# The luxos flake, a text/template rendered per host into the staging tree.
# Every input, nixpkgs included, is derived from the selected modules' own
# luxos.inputs declarations (nix.RenderInputs), so a module needs nothing
# beyond its own file to add one, even on the input's first build.
{
  outputs = inputs: import ./framework/outputs.nix inputs "{{.Host}}";

  inputs = {
{{.Inputs}}  };
}
