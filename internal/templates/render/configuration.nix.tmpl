# LUXOS property - keep walking buddy
# Written into framework/; its imports below only resolve there.

{ config, pkgs, lib, inputs, ... }:

{
  # Modules declare the flake inputs they consume here; luxos reads them to
  # render flake.nix, the system build ignores the value.
  options.luxos.inputs = lib.mkOption {
    type = lib.types.attrsOf lib.types.anything;
    default = { };
    internal = true;
    description = "Flake inputs declared by modules, read by luxos.";
  };

  imports = [
    ./system.nix
    ./environment.nix
    ./hardware-facts.nix
    ./luxos-hardware.nix
    ./luxos-hardware-defaults.nix
    ../config/modules
    ../config/.plsdonttouch.nix
    ../config/machine.nix
{{- range .Settings}}
    {{.}}
{{- end}}
  ];

  config.networking.hostName = "{{.Host}}";
}
