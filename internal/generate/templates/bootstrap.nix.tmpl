# LUXOS property - keep walking buddy
# Written into $STAGING_DIR next to flake.nix, which loads it as a flake-file
# module. Inputs are declared by the modules that consume them.

{ lib, config, inputs, luxos, ... }:

let
  system = "x86_64-linux";

  # flake.nix is the one place flake-file and the default nixpkgs are pinned.
  pinned = (import ./flake.nix).inputs;

  pkgs = import inputs.nixpkgs { inherit system; };

  channelOverlay = import ./framework/overlay.nix { inherit lib inputs system; };

  mkHost = hostName: inputs.nixpkgs.lib.nixosSystem {
    specialArgs = { inherit inputs hostName luxos; };
    modules = [
      ./configuration.nix
      { nixpkgs.hostPlatform = system; nixpkgs.overlays = [ channelOverlay ]; }
    ];
  };
in
{
  # The modules are NixOS modules; here only their flake-file.inputs matter,
  # so anything else they define is accepted and never forced.
  _module.freeformType = lib.types.lazyAttrsOf lib.types.unspecified;
  _module.args = { inherit pkgs; hostName = "{{.Host}}"; };

  imports = [ ./config/modules ];

  # write-flake regenerates flake.nix from exactly these declarations, so the
  # bootstrap inputs must be declared here or the regenerated flake loses them.
  flake-file.inputs.flake-file.url = pinned.flake-file.url;
  flake-file.inputs.nixpkgs.url = lib.mkDefault pinned.nixpkgs.url;

  # The luxos binary itself, installed by framework/system.nix. Declared here
  # (not in system.nix) because flake-file only reads inputs from this file.
  flake-file.inputs.luxos.url = "github:DeprecatedLuar/luxos/main";
  flake-file.inputs.luxos.inputs.nixpkgs.follows = "nixpkgs";

  flake-file.outputs = "inputs: import ./framework/outputs.nix inputs";

  # The staged flake root holds exactly one machine's configuration.nix, so
  # it exposes exactly one host. Regenerated per machine on every run.
  outputs = _inputs: {
    nixosConfigurations.{{.Host}} = mkHost "{{.Host}}";
    apps.${system} = lib.mapAttrs (_: f: {
      type = "app";
      program = lib.getExe (f pkgs);
    }) config.flake-file.apps;
  };
}
