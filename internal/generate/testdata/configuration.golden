# LUXOS property - keep walking buddy
# Written into $STAGING_DIR; its imports below only resolve there.

{ config, pkgs, lib, inputs, ... }:

{
  # Modules declare the flake inputs they consume here; only flake-file reads
  # them (from flake-file.nix), the system build ignores the value.
  options.flake-file.inputs = lib.mkOption {
    type = lib.types.attrsOf lib.types.anything;
    default = { };
    internal = true;
    description = "Flake inputs declared by modules, read by flake-file.";
  };

  imports = [
    ./framework/system.nix
    ./config/modules
    ./config/local/.plsdonttouch.nix
    ./config/local/machine.nix
  ];

  config.networking.hostName = "paraloid";

  config.environment.systemPackages = [
    (pkgs.writeShellScriptBin "nixos-rebuild" ''
      LUXOS_ARGS=(rebuild)
      LUXOS="${inputs.luxos.packages.${pkgs.stdenv.hostPlatform.system}.default}/bin/luxos"
      ${builtins.readFile ./framework/shadow.sh}
    '')
    (pkgs.writeShellScriptBin "nixos" ''
      LUXOS_ARGS=()
      LUXOS="${inputs.luxos.packages.${pkgs.stdenv.hostPlatform.system}.default}/bin/luxos"
      ${builtins.readFile ./framework/shadow.sh}
    '')
  ];
}
